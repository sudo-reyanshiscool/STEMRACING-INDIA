# Public values only. Never put the service_role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Use a dedicated schema when sharing an existing Supabase project.
VITE_SUPABASE_DB_SCHEMA=stem_racing

# Set to 1 to offer the demo sign-in (sample event in memory, no account) on a build that also has a backend.
# It is always offered in `npm run dev`, and when the two Supabase values above are left empty.
VITE_DEMO_LOGIN=
